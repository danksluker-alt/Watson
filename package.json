{
  "name": "watson",
  "productName": "Watson",
  "version": "0.1.0",
  "description": "A voice-first desktop assistant for macOS that answers with Claude and orchestrates your other AI apps.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "postinstall": "bash scripts/patch-electron-plist.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "helper": "bash scripts/build-helper.sh",
    "dist": "npm run helper && npm run build && electron-builder --mac --arm64 --dir && bash scripts/sign-adhoc.sh",
    "start": "electron-vite preview",
    "test": "node --test 'tests/*.test.ts'",
    "e2e": "npm run build && node tests/e2e/run.mjs",
    "e2e:linux": "npm run build && xvfb-run -a node tests/e2e/run.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
